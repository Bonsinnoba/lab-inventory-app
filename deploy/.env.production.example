NODE_ENV=production
HOST=0.0.0.0
PORT=4000
# LAN: bind to the server LAN IP (or 0.0.0.0 if firewall-restricted).
# HTTPS reverse proxy: use 127.0.0.1 so port 4000 is not directly Internet-facing.
LABOS_BIND_ADDRESS=127.0.0.1
TRUST_PROXY=true
ALLOWED_ORIGINS=https://labos.example.com
PGHOST=db
PGPORT=5432
PGDATABASE=lab_inventory
PGUSER=labos
PGPASSWORD=replace-with-a-long-random-password
# PostgreSQL image variables (required by postgres:16-alpine).
# Keep these values identical to PGDATABASE/PGUSER/PGPASSWORD.
POSTGRES_DB=lab_inventory
POSTGRES_USER=labos
POSTGRES_PASSWORD=replace-with-a-long-random-password
STORAGE_DIR=/app/storage
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
MAX_UPLOAD_MB=500
MAX_JSON_MB=2
GEMINI_API_KEY=
# Optional bootstrap model; Settings > AI & Models manages subsequent profiles.
GEMINI_MODEL=
# The main compose file persists generated credential-encryption keys here.
LABOS_AI_SECRET_DIR=/app/private
# Alternatively inject one canonical base64-encoded 32-byte key via secrets management.
LABOS_AI_MASTER_KEY=
# Origins are server-operator policy, not user-controlled inference URLs.
LABOS_AI_CLOUD_ORIGINS=https://api.openai.com
LABOS_AI_LOCAL_ORIGINS=http://labos-model:11434,http://127.0.0.1:11434,http://localhost:11434,http://host.docker.internal:11434
PUBLIC_BASE_URL=https://labos.example.com
API_VERSION=1
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
