NODE_ENV=production
HOST=0.0.0.0
PORT=4000
ALLOWED_ORIGINS=https://labos.example.com
PGHOST=db
PGPORT=5432
PGDATABASE=lab_inventory
PGUSER=labos
PGPASSWORD=replace-with-a-long-random-password
STORAGE_DIR=/app/storage
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
MAX_UPLOAD_MB=500
MAX_JSON_MB=2
GEMINI_API_KEY=
PUBLIC_BASE_URL=https://labos.example.com
API_VERSION=1
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
