# Copy this file to .env and fill in your real values. Never commit .env.

NODE_ENV=development

HOST=0.0.0.0
PORT=4000

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:1420

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=lab_inventory
PGUSER=your_user
PGPASSWORD=your_password

# Where uploaded files (images, videos, PDFs, schematic folders, etc.)
# are stored on this machine's disk. Defaults to ./storage if unset —
# point it at a bigger disk/volume if you're storing a lot of video.
STORAGE_DIR=./storage

# Optional absolute paths for media download tools.
# Keep development copies outside the LabOS repository when possible.
# YTDLP_PATH=C:\path\to\yt-dlp.exe
# FFMPEG_PATH=C:\path\to\ffmpeg\bin\ffmpeg.exe

# JWT secret for authentication - change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-at-least-32-chars
JWT_EXPIRES_IN=7d

# Maximum upload size in MB.
MAX_UPLOAD_MB=500

# Google Gemini API key, powers the Lab Assistant chat panel.
# Get one at https://aistudio.google.com/apikey
# Without this set, the app runs fine — only the Assistant panel is
# disabled, and the server logs a clear warning on startup.
GEMINI_API_KEY=your-gemini-api-key

# Maximum JSON request body size in MB.
MAX_JSON_MB=2

# Public URL used in logs and future externally generated links. Optional in development.
PUBLIC_BASE_URL=http://localhost:4000

# API contract version. Do not change casually; clients may use this for compatibility checks.
API_VERSION=1

# Request/server lifecycle limits.
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL pool settings.
PGPOOL_MAX=20
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
