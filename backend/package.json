{
  "name": "lab-inventory-backend",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/run-migration.js",
    "check": "node -e \"const {execFileSync}=require('child_process'); const {globSync}=require('fs'); for (const f of globSync('src/**/*.js')) execFileSync(process.execPath,['--check',f],{stdio:'inherit'});\"",
    "test:security": "node src/test-security-foundation.js",
    "test:f2": "node src/test-f2-foundation.js",
    "test:core-static": "node src/test-core-phase1-static.js",
    "test:track1-phase2-static": "node src/test-track1-phase2-static.js",
    "test:track2-static": "node src/test-track2-static.js",
    "test:track3-static": "node src/test-track3-static.js"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
