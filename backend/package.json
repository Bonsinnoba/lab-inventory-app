{
  "name": "lab-inventory-backend",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/run-migration.js",
    "check": "node -e \"const {execFileSync}=require('child_process'); const {globSync}=require('fs'); for (const f of globSync('src/**/*.js')) execFileSync(process.execPath,['--check',f],{stdio:'inherit'});\""
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "html-to-docx": "^1.8.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "multer": "^2.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
