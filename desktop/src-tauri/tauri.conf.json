{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build",
    "devPath": "../dist",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Lab Inventory",
    "version": "2.2.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": "^(((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)).+|[A-Za-z]:\\\\[^\\r\\n]+\\\\labos-presentation-[0-9a-f-]{36}\\\\Presentation\\.pptx?)$"
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://localhost:4000/*"]
      }
    },
    "systemTray": {
      "iconPath": "icons/icon.ico"
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "resources": ["runtime/docx-03483d22-1e81-4f95-839a-e451bf922112/"],
      "identifier": "com.lab-inventory.app",
      "icon": ["icons/icon.ico"]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Lab Inventory Management",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ]
  }
}
